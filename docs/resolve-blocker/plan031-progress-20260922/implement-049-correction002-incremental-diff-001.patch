+        ('read_json',files.read_json,(path,),('resolve','read','close','loads')),
+        ('object_hash',files.object_hash,({'value':[1,2,3]},),('dumps','encode','sha256','update','hexdigest'))]
+    for route,function,args,targets in routes:
